@page "/cv"
@inherits CustomComponentBase

<PageTitle>Stuart Aitken - CV</PageTitle>

<div class="page-head">
	<div class="breadcrumb" style="justify-content:space-between">
		<span style="display:flex;align-items:center;gap:var(--space-2xs)">
			<MudIconButton OnClick="@(() => Navigation.NavigateTo(Routes.Pages.Index))"
						   Icon="@Icons.Material.Rounded.ArrowBack" />
			<a href="@Routes.Pages.Index">Home</a> / CV
		</span>

		<MudButton Class="btn-primary"
				   Size="Size.Small"
				   OnClick="@(async () => await JsRuntime.InvokeVoidAsync("downloadCv"))">
			Download CV
		</MudButton>
	</div>

	<h1>CV, @DateTime.Now.Year</h1>
</div>

<div class="page-body">
	<div class="cv-panel">
		<div id="cv-container" style="width:100%;display:flex;justify-content:center">
			@if (width == 0)
			{
				<MudProgressCircular Indeterminate Color="Color.Primary" />
			}
			else
			{
				<object data="/downloads/Stuart-Aitken-CV-Nov-2026-Default.pdf"
					width="@width"
					height="@height">
				</object>
			}
		</div>
	</div>
</div>

@code {
	private int width = 0;
	private int height = 0;
	private const double A4PageRatio = 1.414;

	protected async override Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			this.width = (int)Math.Round(await JsRuntime.InvokeAsync<double>("getCvWidth"));
			this.height = (int)Math.Round(this.width * A4PageRatio);
			this.StateHasChanged();
		}

		await base.OnAfterRenderAsync(firstRender);
	}
}