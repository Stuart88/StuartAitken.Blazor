@inherits CustomComponentBase

@page "/projects"

<PageTitle>Stuart Aitken - Projects</PageTitle>

<div class="page-head">
	<div class="breadcrumb">
		<MudIconButton OnClick="@(() => Navigation.NavigateTo(Routes.Pages.Index))"
					   Icon="@Icons.Material.Rounded.ArrowBack" />
		<a href="@Routes.Pages.Index">Home</a> / Projects
	</div>

	<h1>Projects</h1>
	<p class="lead">Every build, sorted by date.</p>
</div>

<div class="page-body">
	<div class="projects-toolbar">
		<MudAutocomplete T="string"
						 Label="Filter name, type, tech"
						 Class="mt-0"
						 @bind-Value="filterString"
						 SearchFunc="@AutoCompleteSearch"
						 ResetValueOnEmptyText="true"
						 CoerceText="false"
						 CoerceValue="true"
						 Adornment="Adornment.Start"
						 AdornmentIcon="@Icons.Material.Filled.Search"
						 IconSize="Size.Medium" />

		<MudSelect T="string" MultiSelection Label="Type" Class="mt-0" Style="min-width:160px"
				   SelectedValues="selectedTypes"
				   SelectedValuesChanged="@((vals) => OnTypeFilterChanged(vals))"
				   MultiSelectionTextFunc="@(selected => $"{selected?.Count ?? 0} selected")">
			@foreach (var type in allTypes)
			{
				<MudSelectItem Value="@type">@type</MudSelectItem>
			}
		</MudSelect>

		<MudSelect T="string" MultiSelection Label="Tech" Class="mt-0" Style="min-width:160px"
				   SelectedValues="selectedTechs"
				   SelectedValuesChanged="@((vals) => OnTechFilterChanged(vals))"
				   MultiSelectionTextFunc="@(selected => $"{selected?.Count ?? 0} selected")">
			@foreach (var tech in allTechs)
			{
				<MudSelectItem Value="@tech">@tech</MudSelectItem>
			}
		</MudSelect>

		<MudCheckBox T="bool" @bind-Value="AppStateContainer.ShowAllProjects" Label="Show all" Class="mt-0 mr-4" />

		<MudIconButton Class="btn-outline" OnClick="@(async () => this.LoadProjectsList())"
					   Icon="@Icons.Material.Rounded.Refresh" />

		@if (this.AppStateContainer.IsAdmin)
		{
			<MudIconButton Class="btn-primary" OnClick="@(() => this.Navigation.NavigateTo($"{Routes.Pages.EditProject}/0"))"
					   Icon="@Icons.Material.Rounded.Add" />
		}
	</div>

	<MudTable Items="@(projects)"
			  Hover="true"
			  Class="projects-table"
			  Breakpoint="Breakpoint.None"
			  Loading="@(this.loading)"
			  T="Project"
			  Filter="FilterFunc"
			  @bind-SelectedItem="selectedProject"
			  OnRowClick="RowClickEvent"
			  LoadingProgressColor="Color.Primary">
		<HeaderContent>
			<MudTh>
				<MudTableSortLabel SortBy="new Func<Project, object>(x=>x.ProjectDate)"
								   InitialDirection="SortDirection.Descending">
					Project date
				</MudTableSortLabel>
			</MudTh>
			<MudTh>
				<MudTableSortLabel SortBy="new Func<Project, object>(x=>x.Name)">
					Name
				</MudTableSortLabel>
			</MudTh>
			<MudHidden Breakpoint="Breakpoint.SmAndDown">
				<MudTh>
					<MudTableSortLabel SortBy="new Func<Project, object>(x=>x.ProjectDurationDays)">
						Duration
					</MudTableSortLabel>
				</MudTh>
				<MudTh>
					Types
				</MudTh>
				<MudTh>
					Tech
				</MudTh>
				<MudTh>
					@*for action btns*@
				</MudTh>
			</MudHidden>
		</HeaderContent>
		<RowTemplate>
			<MudTd DataLabel="ProjectDate" Class="cell-date" Style="width:140px">@context.ProjectDate.ToString("yyyy MMM")</MudTd>
			<MudTd DataLabel="Name">
				<span class="@(context.Featured ? "chip chip--accent" : "chip")">@context.Name</span>
				@if (!string.IsNullOrWhiteSpace(context.ShortDescription))
				{
					<span class="cell-name__desc">@context.ShortDescription</span>
				}
			</MudTd>
			<MudHidden Breakpoint="Breakpoint.SmAndDown">
				<MudTd DataLabel="Duration" Class="cell-duration" Style="width:100px">@StringHelpers.MakePresentableDuration(context)</MudTd>
				<MudTd DataLabel="Types" Style="width:100px">
					@foreach (var type in StringHelpers.SplitList(context.Type))
					{
						<ProjectIcon Src="@StringHelpers.TypeIconSrc(type)" Tooltip="@type" />
					}
				</MudTd>
				<MudTd DataLabel="Tech">
					@foreach (var tech in StringHelpers.SplitList(context.Tech).OrderBy(i => i))
					{
						<ProjectIcon Src="@StringHelpers.TechIconSrc(tech)" Tooltip="@tech" />
					}
				</MudTd>
				<MudTd>
					<MudStack Row Spacing="1" Justify="Justify.FlexEnd">
						@if (this.AppStateContainer.IsAdmin)
						{
							<MudIconButton Class="btn-outline"
									   Size="Size.Small"
									   OnClick="@(() => this.Navigation.NavigateTo($"{Routes.Pages.EditProject}/{context.ID}"))"
									   Icon="@Icons.Material.Rounded.Edit">
							</MudIconButton>
							<MudIconButton Class="btn-danger"
									   Size="Size.Small"
									   OnClick="@(() => this.OnDeleteClicked(context))"
									   Icon="@Icons.Material.Rounded.Delete">
							</MudIconButton>
						}
						<MudButton Class="btn-primary"
								   Size="Size.Small"
								   OnClick="@(() => this.Navigation.NavigateTo($"{Routes.Pages.Projects}/{context.ID}"))">
							View
						</MudButton>
					</MudStack>

				</MudTd>
			</MudHidden>
		</RowTemplate>
	</MudTable>
</div>


@code {

	[Parameter]
	public int? ProjectId { get; set; }

	private IEnumerable<Project> projects = new List<Project>();
	private string filterString = "";
	private Project? selectedProject = null;
	private List<string> autoCompleteList = new();
	private List<string> allTypes = new();
	private List<string> allTechs = new();
	private List<string> selectedTypes = new();
	private List<string> selectedTechs = new();
	private bool loading = true;

	protected override async Task OnInitializedAsync()
	{
		await base.OnInitializedAsync();

		await this.LoadProjectsList();
	}

	private async Task LoadProjectsList()
	{
		this.loading = true;
		this.projects = new List<Project>();
		this.StateHasChanged();

		var data = await Http.GetFromJsonAsync<IEnumerable<Project>>(Routes.Api.Projects_All);

		if (data == null)
		{
			Snackbar.Add("Found no data!", Severity.Error);
		}
		else
		{
			projects = data;

			var projectNames = projects.Select(p => p.Name);
			var projectTechs = projects.SelectMany(p => p.Tech.Split(", ")).Where(i => !string.IsNullOrWhiteSpace(i)).Distinct();
			var projectTypes = projects.SelectMany(p => p.Type.Split(", ")).Where(i => !string.IsNullOrWhiteSpace(i)).Distinct();

			autoCompleteList = projectNames.Concat(projectTechs).Concat(projectTypes).ToList();
			allTechs = projectTechs.OrderBy(i => i).ToList();
			allTypes = projectTypes.OrderBy(i => i).ToList();

			this.loading = false;
			this.StateHasChanged();
		}
	}

	private void RowClickEvent(TableRowClickEventArgs<Project> tableRowClickEventArgs)
	{
		if (this.selectedProject != tableRowClickEventArgs.Item)
		{
			this.selectedProject = tableRowClickEventArgs.Item;
		}

		this.Navigation.NavigateTo($"{Routes.Pages.Projects}/{this.selectedProject.ID}");
	}

	private async Task<IEnumerable<string>> AutoCompleteSearch(string input, CancellationToken token)
	{
		if (string.IsNullOrWhiteSpace(input))
			return new List<string>();

		return autoCompleteList.Where(x => x.Contains(input, StringComparison.InvariantCultureIgnoreCase));
	}

	private void OnTypeFilterChanged(IEnumerable<string> values)
	{
		selectedTypes = values.ToList();
	}

	private void OnTechFilterChanged(IEnumerable<string> values)
	{
		selectedTechs = values.ToList();
	}

	private bool FilterFunc(Project p)
	{
		if (!AppStateContainer.ShowAllProjects && !p.Featured)
			return false;

		if (selectedTypes.Count > 0 && !p.Type.Split(", ").Any(t => selectedTypes.Contains(t)))
			return false;

		if (selectedTechs.Count > 0 && !p.Tech.Split(", ").Any(t => selectedTechs.Contains(t)))
			return false;

		if (string.IsNullOrWhiteSpace(filterString))
			return true;

		string s = filterString.Trim().ToLower();

		string itemData = p.Name.ToLower()
						+ (p.Tech?.ToLower() ?? "")
						+ (p.Type?.ToLower() ?? "");

		if (itemData.Contains(s))
			return true;

		return false;
	}

	private async Task OnDeleteClicked(Project p)
	{

		bool? shouldDelete = await this.Dialog.ShowMessageBox(
			"Delete",
			$"Delete {p.Name}. \n\nAre you sure?",
			yesText: "Delete", cancelText: "Cancel");

		if (shouldDelete == true)
		{
			try
			{
				await this.Http.CustomDeleteAsync(Routes.Api.Projects + p.ID);
			}
			catch (Exception e)
			{
				this.Snackbar.Add(e.Message, Severity.Error);
			}
			finally
			{
				await this.LoadProjectsList();
			}
		}

	}
}
