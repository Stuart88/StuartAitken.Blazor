@using StuartAitken.Blazor.Client.Services
@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject AppStateContainer AppStateContainer
@inject ISnackbar Snackbar
@inject HttpClient Http
@inject IJSRuntime JsRuntime

<MudLayout>
	<MudAppBar Elevation="0">
		<nav class="site-nav">
			<a class="site-wordmark" href="@Routes.Pages.Index">@Constants.SiteName</a>

			<div class="site-nav-right">
				<MudHidden Breakpoint="Breakpoint.SmAndDown">
					<div class="site-nav-links">
						<MudButton Class="@NavLinkClass(Routes.Pages.Index)" OnClick="@(() => Navigation.NavigateTo(Routes.Pages.Index))">Home</MudButton>
						<MudButton Class="@NavLinkClass(Routes.Pages.Projects)" OnClick="@(() => Navigation.NavigateTo(Routes.Pages.Projects))">Projects</MudButton>
						<MudButton Class="@NavLinkClass(Routes.Pages.CV)" OnClick="@(() => Navigation.NavigateTo(Routes.Pages.CV))">CV</MudButton>
					</div>
				</MudHidden>

				<MudTooltip Text="@(isDarkMode ? "Switch to light mode" : "Switch to dark mode")">
					<MudIconButton Class="nav-menu-toggle"
								   Icon="@(isDarkMode ? Icons.Material.Rounded.LightMode : Icons.Material.Rounded.DarkMode)"
								   OnClick="ToggleTheme" />
				</MudTooltip>

				<MudHidden Breakpoint="Breakpoint.MdAndUp">
					<MudIconButton Class="nav-menu-toggle" Icon="@Icons.Material.Rounded.Menu" Edge="Edge.End" OnClick="@((e) => DrawerToggle())" />
				</MudHidden>
			</div>
		</nav>
	</MudAppBar>
	<MudDrawer @bind-Open="@_drawerOpen" Elevation="0">
		<NavMenu />
	</MudDrawer>
	<MudMainContent>
		@Body

		<footer class="site-footer">
			<div class="site-footer-inner page-body" style="padding-bottom:0">
				<div class="site-footer-top">
					<div>
						<p class="site-footer-wordmark">@Constants.SiteName</p>
						<p class="site-footer-tagline">Built with Blazor WebAssembly, .NET 10 and SQL Server.</p>
					</div>

					<ul class="site-footer-links">
						<li><a href="@Routes.Pages.Index">Home</a></li>
						<li><a href="@Routes.Pages.Projects">Projects</a></li>
						<li><a href="@Routes.Pages.CV">CV</a></li>
						<li><a href="https://github.com/Stuart88" target="_blank" rel="noopener">GitHub</a></li>
					</ul>
				</div>

				<div class="site-footer-bottom">
					<span class="site-footer-legal">&copy; @DateTime.Now.Year Stuart Aitken</span>

					<div class="login-container">
						@if (AppStateContainer.IsAdmin)
						{
							<MudButton Size="Size.Small" OnClick="@(() => {
												AppStateContainer.IsAdmin = false;
												AppStateContainer.Password = "";
												this.StateHasChanged();
																		})">
								Logout
							</MudButton>
						}
						else
						{
							<form @onsubmit:preventDefault="true" autocomplete="on">
								<MudTextField Class="login"
										  @bind-Value="AppStateContainer.Password"
										  Label="Admin login"
										  InputType="InputType.Password"
										  Variant="Variant.Outlined"
										  UserAttributes="@(new Dictionary<string, object> { { "autocomplete", "current-password" } })"
										  OnKeyUp="OnPasswordKeyPress"
										  Margin="Margin.Dense">
								</MudTextField>
							</form>
						}
					</div>
				</div>
			</div>
		</footer>
	</MudMainContent>
</MudLayout>



@code {
	bool _drawerOpen = false;
	bool isDarkMode = true;

	void DrawerToggle()
	{
		_drawerOpen = !_drawerOpen;
	}

	private async Task ToggleTheme()
	{
		isDarkMode = !isDarkMode;
		await JsRuntime.InvokeVoidAsync("setTheme", isDarkMode ? "dark" : "light");
		StateHasChanged();
	}

	private string NavLinkClass(string page)
	{
		var current = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).TrimEnd('/');
		bool isActive = page == Routes.Pages.Index ? current == Routes.Pages.Index : current.StartsWith(page);
		return isActive ? "site-nav-link is-active" : "site-nav-link";
	}

	private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => StateHasChanged();

	protected override async Task OnInitializedAsync()
	{
		AppStateContainer.OnPasswordChange += StateHasChanged;
		AppStateContainer.OnChange += StateHasChanged;
		Navigation.LocationChanged += OnLocationChanged;

		await base.OnInitializedAsync();
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			// The inline script in index.html already set data-theme (from localStorage,
			// or the OS preference) before Blazor booted, to avoid a flash of the wrong theme.
			var theme = await JsRuntime.InvokeAsync<string>("getTheme");
			bool shouldBeDark = theme != "light";

			if (shouldBeDark != isDarkMode)
			{
				isDarkMode = shouldBeDark;
				StateHasChanged();
			}
		}

		await base.OnAfterRenderAsync(firstRender);
	}

	private async Task OnPasswordKeyPress(KeyboardEventArgs args)
	{
		if (args.Key == "Enter")
		{
			Http.AddAuthHeader(AppStateContainer.Password);
			var response = await Http.GetAsync(Routes.Api.Auth);
			ApiResponse? result = await response.Content.ReadFromJsonAsync<ApiResponse>();

			if (result?.Ok == true)
			{
				AppStateContainer.IsAdmin = true;
				this.StateHasChanged();
			}
			else
			{
				string? message = result?.Error;
				Snackbar.Add(string.IsNullOrWhiteSpace(message) ? "Login failed" : message, Severity.Info);
			}

		}
	}
}


<MudThemeProvider IsDarkMode="@isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />