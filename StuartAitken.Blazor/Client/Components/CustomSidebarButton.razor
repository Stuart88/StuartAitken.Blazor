<MudNavLink Href="@Href"
			Match="NavLinkMatch.All"
			Target="@Target"
			Style="text-align:left">
	<MudButton StartIcon="@Icon"
			   Variant="Variant.Filled"
			   Color="Color.Primary"
			   Style="background-color:var(--color-accent);color:var(--color-accent-ink);justify-content:left"
			   FullWidth>@Text</MudButton>
</MudNavLink>

@code {
	[Parameter]
	public string Href { get; set; }

	[Parameter]
	public string Text { get; set; }

	[Parameter]
	public string Icon { get; set; }

	[Parameter]
	public string Target { get; set; }
}
