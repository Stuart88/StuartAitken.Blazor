@using StuartAitken.Blazor.Client.Helpers

@if (Project != null)
{
	<div class="reading__facts">
		<dl>
			<div class="fact-row">
				<dt>Date</dt>
				<dd>@Project.ProjectDate.ToString("dd MMM yyyy")</dd>
			</div>
			<div class="fact-row">
				<dt>Duration</dt>
				<dd>@StringHelpers.MakePresentableDuration(Project)</dd>
			</div>
			<div class="fact-row">
				<dt>Type</dt>
				<dd><div class="reading__icons">@foreach (var type in StringHelpers.SplitList(Project.Type))
					{
						<ProjectIcon Small Src="@StringHelpers.TypeIconSrc(type)" Tooltip="@type" />
					}</div></dd>
			</div>
			<div class="fact-row">
				<dt>Tech</dt>
				<dd><div class="reading__icons">@foreach (var tech in StringHelpers.SplitList(Project.Tech).OrderBy(i => i))
					{
						<ProjectIcon Small Src="@StringHelpers.TechIconSrc(tech)" Tooltip="@tech" />
					}</div></dd>
			</div>
		</dl>

		@if (!string.IsNullOrEmpty(Project.Urls))
		{
			<div class="fact-links">
				@foreach (string url in Project.Urls.Split(", "))
				{
					<MudLink Href="@url" Target="_blank">
						@url
					</MudLink>
				}
			</div>
		}
	</div>
}

@code {
	[Parameter]
	public Project Project { get; set; }
}
